# Optional: real OpenAI-compatible model for /api/advice.
# Without these, the page still works and labels the advice as rules-generated.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# DeepSeek V4 needs this to stop reasoning from consuming the output budget.
LLM_DISABLE_THINKING=1
